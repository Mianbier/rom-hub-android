<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 下载：前台服务保活 + 唤醒锁（任务全停就自己退出，不常驻） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 下载完成时的震动提示（用户可在设置里关） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 下载文件要落到公共 Download/rom-hub/：
         Android 10 及以下用 WRITE_EXTERNAL_STORAGE，11+ 用「所有文件访问」(MANAGE_EXTERNAL_STORAGE)。
         后者需要用户到系统设置页手动开，首次进 App 会引导。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".RomHubApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.RomHub">

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.RomHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 自有深链：romhub://download?url=...（外部 App 也能唤起下载） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="romhub" />
            </intent-filter>

            <!-- 网盘分享链接：在浏览器/其他 App 里点链接时，能选「用 ROM Hub 打开」
                 直接进下载页并开始解析下载。只认这几家的域名，不会抢别的链接。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.quark.cn" />
                <data android:scheme="https" android:host="drive.uc.cn" />
                <data android:scheme="https" android:host="pan.baidu.com" />
                <data android:scheme="https" android:host="115.com" />
                <data android:scheme="https" android:host="115cdn.com" />
                <data android:scheme="https" android:host="115rc.com" />
                <data android:scheme="https" android:host="www.123pan.com" />
                <data android:scheme="https" android:host="www.123865.com" />
                <data android:scheme="https" android:host="yun.139.com" />
                <data android:scheme="https" android:host="pan.xunlei.com" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ============================================================
             HyperCeiler 的「首次启动引导」流程（整套照抄自 library/provision）。
             入口 DefaultActivity 由 MainActivity 在「没走过流程」时拉起。
             ============================================================ -->
        <activity
            android:name="org.linbaogu.romhub.hc.provision.activity.DefaultActivity"
            android:exported="true"
            android:theme="@style/ProvisionTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.linbaogu.romhub.hc.provision.activity.BasicSettingsActivity"
            android:exported="true"
            android:theme="@style/ProvisionTheme" />

        <!-- 登录：引导流程里排在「基础设置」和「开始使用」之间。
             外壳沿用 HyperCeiler 的 provision_detail_layout 骨架 + Miuix 按钮组，
             中间的表单是 Compose + Miuix TextField。 -->
        <activity
            android:name="org.linbaogu.romhub.hc.provision.activity.LoginActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name="org.linbaogu.romhub.hc.provision.activity.PermissionSettingsActivity"
            android:exported="true"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name="org.linbaogu.romhub.hc.provision.activity.TermsAndStatementActivity"
            android:exported="true"
            android:theme="@style/ProvisionTheme" />

        <activity
            android:name="org.linbaogu.romhub.hc.provision.activity.CongratulationActivity"
            android:exported="true"
            android:theme="@style/ProvisionTheme" />

        <service
            android:name="org.linbaogu.romhub.hc.provision.service.ProvisionAnimService"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="fan.intent.action.OOBSERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
