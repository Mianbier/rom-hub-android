<?xml version="1.0" encoding="utf-8"?>
<!--
  引导流程「登录」页的内容区。
  外壳（返回箭头 / 预览图 / 标题 / 底部蓝色按钮组）由 fan.provision.ProvisionBaseActivity
  统一提供 —— 和权限页、协议页、基础设置页是同一套骨架，所以观感和它们完全一致。
  这里只放中间那块表单：用 Compose + Miuix 的 TextField（就是 HyperOS 那套输入框）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/miuix_theme_padding_horizontal_common">

        <TextView
            style="@style/ProvisionListSecondaryTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="@dimen/miuix_theme_content_padding_horizontal_common"
            android:text="@string/provision_login_desc"
            android:textSize="13sp" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/login_compose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
